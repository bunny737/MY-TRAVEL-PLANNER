# Production image for Google Cloud Run (Module 07). Build from backend/:
#   docker build -f Dockerfile.prod -t travel-web .
# Runtime config comes only from environment variables / Secret Manager (see deploy/cloudrun/).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DJANGO_SETTINGS_MODULE=config.settings.prod \
    PORT=8080

WORKDIR /app

# Production requirements only (no dev tools, no Pillow). psycopg[binary] needs no system libraries.
COPY requirements/ requirements/
RUN pip install -r requirements/prod.txt

COPY . .

# Static files are collected at build time and served by WhiteNoise. collectstatic needs no secrets, so it runs with
# the base settings and a throwaway key that never reaches the running service.
RUN DJANGO_SETTINGS_MODULE=config.settings.base SECRET_KEY=collectstatic-only \
    python manage.py collectstatic --noinput \
    && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin app \
    && chown -R app /app/staticfiles

USER app

# Cloud Run sends traffic to $PORT. One instance handles concurrent requests with threads; --timeout 0 leaves
# request timeouts to Cloud Run. Access logs are off: Cloud Run already logs requests, and query strings stay out
# of our own logs.
CMD exec gunicorn config.wsgi:application --bind ":${PORT}" --workers 2 --threads 4 --timeout 0 \
    --error-logfile - --log-level info
