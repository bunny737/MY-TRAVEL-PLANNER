# Copy to .env (gitignored). Never commit real values.

# --- Docker host ports (chosen to avoid pg-management-web: 3000/5433/6379/8000) ---
WEB_HOST_PORT=8100
DB_HOST_PORT=5440

# --- Django ---
SECRET_KEY=change-me-dev-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:8100,http://127.0.0.1:8100
# Obscure the admin path in production (e.g. manage-xxxx/). Leave "admin/" locally.
ADMIN_URL_PATH=admin/

# --- Database — the app MUST connect as the non-superuser app_user (docker/postgres/init.sql) ---
DB_NAME=travel_platform
DB_USER=app_user
DB_PASSWORD=app_password
# Inside Compose the service name and container port; use localhost:5440 from the host.
DB_HOST=db
DB_PORT=5432
POSTGRES_ADMIN_PASSWORD=postgres

# --- Site identity (invariant 9: no hardcoded business config) ---
# Brand: My Travel Planner. Domain: mytravelplanner.in (canonical = no www). See the production block at the bottom.
SITE_NAME=My Travel Planner
SITE_BASE_URL=http://localhost:8100
# Dedicated WhatsApp Business app number, digits only with country code (wa.me format), e.g. 919XXXXXXXXX
WHATSAPP_NUMBER=
# Pre-filled first WhatsApp message. Keep it generic: no names, phone numbers or trip details.
WHATSAPP_PREFILL_TEXT=Hi, I want a tour quote.
CONTACT_EMAIL=
CONTACT_PHONE=
# Shown on the site; must match the Google Ads schedule (execution plan §5/§6).
RESPONSE_HOURS_TEXT=Weekdays 7-9 AM and 7-10 PM IST; weekends 8 AM-10 PM IST
# Bump when the consent wording changes; stored on every Lead.
CONSENT_NOTICE_VERSION=2026-10-v1
# Where new-lead notifications go (optional; admin check is enough at tiny volume).
LEAD_NOTIFY_EMAIL=
# Lead form throttle per client IP: "<count>/<seconds>"
LEAD_FORM_THROTTLE=5/3600
# Free pilot referrals per partner before any fee applies (plan §7: 2-3).
PILOT_REFERRALS_PER_PARTNER=3
# A price on a package/cab/stay page (copied from a dated partner quote) hides itself after this many days.
PRICE_MAX_AGE_DAYS=90
# Same phone + service inside this many hours is flagged as a duplicate (saved, but not counted again).
LEAD_DUPLICATE_WINDOW_HOURS=24
# Header with the real client IP. Blank = REMOTE_ADDR. Cloud Run: X-Forwarded-For with TRUSTED_HOPS=1
# (2 behind a Google load balancer). Only the entries our own proxies append are trusted.
CLIENT_IP_HEADER=
CLIENT_IP_TRUSTED_HOPS=1
# Throttle storage shared by all processes: file (one host) or db (Cloud Run; run `createcachetable`).
CACHE_BACKEND=file
# Hosts that 301 to the SITE_BASE_URL host, e.g. www.mytravelplanner.in. Blank locally.
REDIRECT_TO_CANONICAL_HOSTS=
# Production behind the nginx edge only: read the public host from X-Forwarded-Host (docs/deployment.md §5).
USE_X_FORWARDED_HOST=False
# Production only, a Secret Manager secret: the key the nginx edge sends. Blank = no edge check (local).
EDGE_SHARED_SECRET=
# Admin authenticator-app codes. Off locally; production forces it on.
ADMIN_REQUIRE_MFA=False

# --- Email (optional) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# --- Tracking (Module 06). Leave blank to disable a tag. ---
GA4_MEASUREMENT_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_FORM_CONVERSION_LABEL=
GOOGLE_ADS_WHATSAPP_CONVERSION_LABEL=
GOOGLE_ADS_CALL_CONVERSION_LABEL=
GOOGLE_SITE_VERIFICATION=

# --- Production only (config.settings.prod; see docs/deployment.md) ---
SECURE_HSTS_SECONDS=0
DB_SSLMODE=prefer
SENTRY_DSN=

# --- Production (Cloud Run) values live in deploy/cloudrun/env.prod.yaml + Secret Manager, never in this file.
#     Template: deploy/cloudrun/env.prod.yaml.example; steps: docs/deployment.md.
