# Non-secret runtime config for the Cloud Run service and jobs (Module 07).
# Copy to env.prod.yaml (gitignored), fill the <...> values, then run deploy.sh.
# Secrets (SECRET_KEY, DB_PASSWORD, EMAIL_HOST_PASSWORD) are NOT here: they come from Secret Manager (deploy.sh).
# Cloud Run needs every value as a string, so numbers and booleans are quoted.

DJANGO_SETTINGS_MODULE: "config.settings.prod"

# --- Site and hosts ---
SITE_NAME: "My Travel Planner"
SITE_BASE_URL: "https://mytravelplanner.in"
# Add the service's own *.run.app host so you can smoke-test before DNS points at the nginx edge.
ALLOWED_HOSTS: "mytravelplanner.in,www.mytravelplanner.in,<service-url-host>.run.app"
CSRF_TRUSTED_ORIGINS: "https://mytravelplanner.in,https://www.mytravelplanner.in"
REDIRECT_TO_CANONICAL_HOSTS: "www.mytravelplanner.in"   # nginx already sends www to the apex; kept as a backstop
# Behind the nginx edge on pglive-worker: Host is the run.app name, the public host comes in X-Forwarded-Host.
USE_X_FORWARDED_HOST: "True"
# Long and random, ending in "/". Not "admin/" (production refuses it). Keep it out of chats and screenshots.
ADMIN_URL_PATH: "<random-path>/"
# Raise to 31536000 (one year) only after HTTPS works on both mytravelplanner.in and www for a few days.
SECURE_HSTS_SECONDS: "0"

# --- Cloud SQL: PGLive's instance, our own database and role (deploy/cloudsql/create-travel-db.sql) ---
DB_NAME: "travel_platform"
DB_USER: "travel_app"
DB_HOST: "/cloudsql/pglive-prod:asia-south1:pglive-pg-prod"
DB_PORT: "5432"
DB_SSLMODE: "disable"   # unix socket through the Cloud SQL connector; already encrypted by Google

# --- Cloud Run specifics ---
CACHE_BACKEND: "db"                 # throttle counters shared by all instances (table created by the migrate job)
CLIENT_IP_HEADER: "X-Forwarded-For"
CLIENT_IP_TRUSTED_HOPS: "2"         # nginx writes the visitor, Google appends the edge VM (docs/deployment.md §5)

# --- Business config (CLAUDE.md invariant 9) ---
WHATSAPP_NUMBER: "<91XXXXXXXXXX>"
WHATSAPP_PREFILL_TEXT: "Hi, I want an Araku tour quote."
CONTACT_EMAIL: "<contact@mytravelplanner.in>"
CONTACT_PHONE: "<+91XXXXXXXXXX>"
RESPONSE_HOURS_TEXT: "Weekdays 7-9 AM and 7-10 PM IST; weekends 8 AM-10 PM IST"
CONSENT_NOTICE_VERSION: "2026-10-v1"
LEAD_NOTIFY_EMAIL: "<you@example.com>"
LEAD_FORM_THROTTLE: "5/3600"
LEAD_DUPLICATE_WINDOW_HOURS: "24"
PILOT_REFERRALS_PER_PARTNER: "3"

# --- Email (lead notifications). Cloud Run blocks port 25; use 587 with TLS. ---
EMAIL_BACKEND: "django.core.mail.backends.smtp.EmailBackend"
EMAIL_HOST: "<smtp.example.com>"
EMAIL_PORT: "587"
EMAIL_HOST_USER: "<smtp-user>"
EMAIL_USE_TLS: "True"
DEFAULT_FROM_EMAIL: "<noreply@mytravelplanner.in>"

# --- Tracking (Module 06). Blank = tag not rendered. Fill only after the consent-banner decision. ---
GA4_MEASUREMENT_ID: ""
GOOGLE_ADS_ID: ""
GOOGLE_ADS_FORM_CONVERSION_LABEL: ""
GOOGLE_ADS_WHATSAPP_CONVERSION_LABEL: ""
GOOGLE_ADS_CALL_CONVERSION_LABEL: ""
GOOGLE_SITE_VERIFICATION: ""

SENTRY_DSN: ""
